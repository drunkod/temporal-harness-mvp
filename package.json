{
  "name": "temporal-harness-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "seed": "npm run build && node dist/seed.js",
    "worker": "node dist/worker.js",
    "start": "node dist/cli.js start",
    "status": "node dist/cli.js status",
    "list": "node dist/cli.js list",
    "verify": "node dist/verify.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:portable": "npm run build && node --test tests/flowdeck-*.test.mjs tests/sashai-live-browser.test.mjs",
    "dashboard": "node dist/dashboard-server.js",
    "demo": "npm run build && node dist/dashboard-server.js",
    "sashai:status": "node scripts/sashai-supervisor.mjs status",
    "sashai:preview": "npm run build && node scripts/sashai-supervisor.mjs preview",
    "sashai:adopt": "node scripts/sashai-supervisor.mjs adopt",
    "oracle:doctor": "node scripts/oracle-sashai.mjs doctor",
    "oracle:pin": "node scripts/prepare-oracle-local.mjs",
    "oracle:diagnose": "node scripts/oracle-sashai.mjs diagnose",
    "sashai:auto-adopt": "node scripts/sashai-supervisor.mjs auto-adopt",
    "sashai:supervise": "node scripts/sashai-supervisor.mjs supervise forever",
    "sashai:watcher-status": "bash scripts/manage-sashai-watcher.sh status",
    "sashai:report:status": "node scripts/sashai-report-dispatch.mjs status",
    "sashai:report:verify": "node scripts/verify-sashai-browser-report.mjs --preview",
    "sashai:temporal:status": "node scripts/sashai-report-temporal.mjs status",
    "sashai:temporal:binding-status": "node scripts/sashai-binding-proof.mjs status",
    "sashai:temporal:fixture-repair-status": "node scripts/sashai-synthetic-temporal.mjs status repair",
    "sashai:temporal:fixture-uncertain-status": "node scripts/sashai-synthetic-temporal.mjs status uncertain",
    "sashai:live:status": "node scripts/sashai-live-temporal.mjs status",
    "sashai:live:worker": "node scripts/sashai-live-temporal.mjs worker",
    "sashai:live:start": "node scripts/sashai-live-temporal.mjs start",
    "flowdeck:autonomy:preflight": "npm run build && node scripts/flowdeck-controller.mjs preflight",
    "flowdeck:autonomy:status": "npm run build && node scripts/flowdeck-controller.mjs status",
        "supervisor:status": "node scripts/flowdeck-supervisor.mjs status",
        "supervisor:worker": "npm run build && node scripts/flowdeck-supervisor.mjs worker",
        "supervisor:start": "npm run build && node scripts/flowdeck-supervisor.mjs start",
        "supervisor:workflow-status": "node scripts/flowdeck-supervisor.mjs workflow-status",
        "supervisor:events": "node scripts/flowdeck-work-events.mjs",
            "supervisor:smoke": "npm run build && node scripts/flowdeck-supervisor-smoke.mjs",
        "jazz:build": "node widgets/jazz-status/build.mjs"
  },
  "dependencies": {
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@temporalio/activity": "^1.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
